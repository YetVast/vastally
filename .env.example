# ==============================================================================
# VastAlliance V0 — Environment Variables Reference
# ==============================================================================

# Central Yet Vast Auth Service Origin
YETVAST_AUTH_ORIGIN="https://auth.yetvast.com"

# Centrally Registered Application ID in Yet Vast Auth
YETVAST_APP_ID="vastalliance"

# Server-Only App Admin Allowlist (comma-separated canonical Yet Vast user IDs)
YETVAST_APP_ADMIN_USER_IDS="yvnowyv"

# Host-Bound Session Cookie Signing Secret (minimum 32 characters in production)
SESSION_SECRET="replace-with-a-cryptographically-secure-random-secret-for-production"

# Application Public Origin
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3000"

# Optional Cloud Firestore Configuration (Firebase Admin SDK)
# If omitted during local development/testing, an in-memory transactional store is used automatically.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Build-Time / CI Package Registry Authentication (GitHub Classic PAT with read:packages)
# Set in Vercel Project Settings as Sensitive environment variable
NODE_AUTH_TOKEN=""
